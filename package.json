{
  "name": "medtracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run tests/domain.test.ts",
    "test:rules": "firebase emulators:exec --project demo-medtracker --only firestore \"vitest run tests/firestore.test.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-medtracker --only auth,firestore \"playwright test --project tracker\"",
    "emulators": "firebase emulators:start --project demo-medtracker --only auth,firestore",
    "test:production": "playwright test --project production"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.37.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
